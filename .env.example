# Runtime mode: paper_sim | dry_run | gate_demo
CEX_TBOT_EXECUTION_MODE=gate_demo

# Gate demo API credentials
GATE_DEMO_API=https://fx-api-testnet.gateio.ws/api/v4
GATE_DEMO_KEY=replace_with_gate_demo_key
GATE_DEMO_SECRET=replace_with_gate_demo_secret
GATE_DEMO_TEST_ORDER_SIZE=1.0
GATE_DEMO_LEVERAGE=10

# REST bridge auth (optional but recommended)
CEX_TBOT_API_TOKEN=replace_with_rest_api_token

# Telegram runner
CEX_TBOT_TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
CEX_TBOT_ALLOWED_SENDER_IDS=125619710
CEX_TBOT_TELEGRAM_ALLOWED_CHAT_IDS=-1003832858724
CEX_TBOT_TELEGRAM_ALLOWED_THREAD_IDS=7

# Optional risk/config overrides
CEX_TBOT_MIN_CONFIDENCE_SCORE=0.70
CEX_TBOT_MAX_AGGREGATE_OPEN_RISK_PERCENT=1.0
CEX_TBOT_MAX_DAILY_DRAWDOWN_PERCENT=2.0
CEX_TBOT_MAX_OPEN_POSITIONS=2
