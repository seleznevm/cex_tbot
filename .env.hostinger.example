# Copy this file to `.env` on the VPS.
# Telegram bot token variable name used by the container:
# CEX_TBOT_TELEGRAM_BOT_TOKEN

# Runtime mode: start with `paper_sim` if you want a safe dry rollout on VPS.
# Switch to `gate_demo` after Gate demo API credentials are set.
CEX_TBOT_EXECUTION_MODE=paper_sim

# Gate demo API credentials
GATE_DEMO_API=https://fx-api-testnet.gateio.ws/api/v4
GATE_DEMO_KEY=replace_with_gate_demo_key
GATE_DEMO_SECRET=replace_with_gate_demo_secret
GATE_DEMO_TEST_ORDER_SIZE=1.0
GATE_DEMO_LEVERAGE=10

# REST/UI auth
CEX_TBOT_API_TOKEN=replace_with_strong_rest_api_token

# Telegram runner
CEX_TBOT_TELEGRAM_BOT_TOKEN=replace_with_real_telegram_bot_token

# Telegram user ids allowed to operate slash commands:
# /trade_approve, /trade_reject, /modify, /status, etc.
CEX_TBOT_ALLOWED_SENDER_IDS=replace_with_operator_user_id

# Telegram user ids allowed to submit raw JSON proposals.
# If the same people do both, reuse the same id list as above.
CEX_TBOT_JSON_SUBMITTER_IDS=replace_with_json_submitter_user_id

# Your real Telegram group/topic binding
CEX_TBOT_TELEGRAM_ALLOWED_CHAT_IDS=-1003832858724
CEX_TBOT_TELEGRAM_ALLOWED_THREAD_IDS=7

# Optional risk/config overrides
CEX_TBOT_MIN_CONFIDENCE_SCORE=0.70
CEX_TBOT_MAX_AGGREGATE_OPEN_RISK_PERCENT=1.0
CEX_TBOT_MAX_DAILY_DRAWDOWN_PERCENT=2.0
CEX_TBOT_MAX_OPEN_POSITIONS=2
